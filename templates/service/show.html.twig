{% extends 'base.html.twig' %}

{% block title %}Service{% endblock %}

{% block body %}
    <h1>Service</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ service.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ service.titre }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ service.description }}</td>
            </tr>
            <tr>
                <th>Prix</th>
                <td>{{ service.prix }}</td>
            </tr>
            <tr>
                <th>Duree</th>
                <td>{{ service.duree }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>
                    {% if service.image %}
                        <img src="{{ asset('uploads/services/' ~ service.image) }}" alt="{{ service.titre }}" style="max-width: 200px;">
                    {% else %}
                        <span>Aucune image</span>
                    {% endif %}
                </td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_service_index') }}">back to list</a>

    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_service_edit', {'id': service.id}) }}">edit</a>

        {{ include('service/_delete_form.html.twig') }}
    {% endif %}
{% endblock %}